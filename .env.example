# Momentus environment variables (example).
# Copy to `.env` and fill in. `.env*` is git-ignored; never commit real values.
#
# The MVP is local-first with no backend data, so none of these are required
# to run the app. They are placeholders for later phases.

# --- Web Push (optional; Next.js PWA push notifications) ---
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
