# Momentus environment variables (example).
# Copy to `.env` and fill in. `.env*` is git-ignored; never commit real values.

# --- Auth (NextAuth / Auth.js v5) — REQUIRED for server auth (M1) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# --- Database (Vercel Postgres / Neon) — REQUIRED (M1) ---
# Provided by Vercel when you create a Postgres store. Prisma reads DATABASE_URL.
DATABASE_URL=

# --- Blob storage (Vercel Blob) — REQUIRED for entry sync (M2) ---
# Provided by Vercel when you create a Blob store.
# BLOB_READ_WRITE_TOKEN=

# --- Seeding the initial user (run once, out-of-band; never commit the value) ---
# SEED_INITIAL_PASSWORD=
