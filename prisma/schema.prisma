// Momentus — Prisma schema (Milestone 1: auth/server foundation).
//
// Source of truth for users (and, in M2, entries). Binaries NEVER live in the
// DB — M2's Entry stores Vercel Blob pointers (url/type/size) only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Vercel–Supabase integration provides these (same names on Vercel + local):
  //   *_PRISMA_URL      = pooled (PgBouncer, port 6543) — runtime
  //   *_URL_NON_POOLING = direct (port 5432) — migrations (PgBouncer can't migrate)
  url       = env("MOMENTUS_DB_POSTGRES_PRISMA_URL")
  directUrl = env("MOMENTUS_DB_POSTGRES_URL_NON_POOLING")
}

/// The single seeded account (FR23). NextAuth Credentials verifies against
/// passwordHash; `mustChange` forces a password change on first login (FR23).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  mustChange   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // entries   Entry[]  // added in M2
}
