// Momentus — Prisma schema (Milestone 1: auth/server foundation).
//
// Source of truth for users (and, in M2, entries). Binaries NEVER live in the
// DB — M2's Entry stores Vercel Blob pointers (url/type/size) only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Vercel–Supabase integration provides these (same names on Vercel + local):
  //   *_PRISMA_URL      = pooled (PgBouncer, port 6543) — runtime
  //   *_URL_NON_POOLING = direct (port 5432) — migrations (PgBouncer can't migrate)
  url       = env("MOMENTUS_DB_POSTGRES_PRISMA_URL")
  directUrl = env("MOMENTUS_DB_POSTGRES_URL_NON_POOLING")
}

/// The single seeded account (FR23). NextAuth Credentials verifies against
/// passwordHash; `mustChange` forces a password change on first login (FR23).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  mustChange   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  entries      Entry[]
}

/// A journal entry, account-scoped and synced across the user's devices
/// (FR27-FR32). Binaries live in Vercel Blob — only the pointer (url/type/size)
/// is stored here, NEVER the bytes. `updatedAt` is the last-write-wins key and
/// `deleted` is the tombstone for sync (FR30). `id` is client-generated (UUID)
/// and honored by the server so ids stay stable across the sync boundary.
model Entry {
  id                String   @id
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime
  updatedAt         DateTime
  deleted           Boolean  @default(false)
  modality          String // 'audio' | 'text'
  textContent       String   @default("")
  transcriptPending Boolean  @default(false)
  lat               Float?
  lng               Float?
  dayKey            String
  // Vercel Blob pointers — bytes are NEVER stored in the DB (FR28).
  audioUrl          String?
  audioType         String?
  audioSize         Int?
  photoUrl          String?
  photoType         String?
  photoSize         Int?

  @@index([userId, updatedAt]) // changed-since pulls
  @@index([userId, dayKey]) // server-side 5/day (FR32)
}
