# ---------------------------------------------------------------------------
# Momentus .gitignore — web (Next.js PWA) + mobile (Capacitor/iOS) + tooling
# ---------------------------------------------------------------------------

# --- Dependencies ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Node / package manager logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# --- Next.js ---
/.next/
/out/
next-env.d.ts
.next
*.tsbuildinfo

# --- Production build artifacts ---
/build
/dist

# --- Testing / coverage ---
/coverage
*.lcov
.vitest/
.nyc_output

# --- Service worker (generated by Serwist) ---
public/sw.js
public/sw.js.map
public/swe-worker-*.js
public/workbox-*.js

# --- Environment / secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.mobileprovision
secrets.*
.secrets/

# --- Vercel ---
.vercel

# --- Capacitor / native shells ---
# Keep capacitor.config.ts tracked; ignore generated native platform build output.
/ios/App/Pods/
/ios/App/build/
/ios/App/output/
/ios/App/App/public/
/ios/DerivedData/
/android/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
xcuserdata/
/ios/App/App.xcworkspace/xcshareddata/swiftpm/

# --- iOS / Xcode ---
*.ipa
*.dSYM.zip
*.dSYM
DerivedData/
.swiftpm/

# --- Editors / IDEs ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# --- OS cruft ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Misc tooling caches ---
.eslintcache
.cache/
.turbo/
*.log

# --- Local-only agent artifacts (PO reviews are kept in the Obsidian vault) ---
.kiro/reviews/
